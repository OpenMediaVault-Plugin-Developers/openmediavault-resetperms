msgid "Administrator - read/write, Users - no access, Others - no access"
msgstr ""
"ຜູ້ດູແລລະບົບ - ອ່ານ/ຂຽນ, ຜູ້ໃຊ້ - ບໍ່ມີສິດເຂົ້າເຖິງ, ອື່ນໆ - "
"ບໍ່ມີສິດເຂົ້າເຖິງ"

msgid "Administrator - read/write, Users - read-only, Others - no access"
msgstr ""
"ຜູ້ດູແລລະບົບ - ອ່ານ/ຂຽນ, ຜູ້ໃຊ້ - ອ່ານຢ່າງດຽວ, ອື່ນໆ - ບໍ່ມີສິດເຂົ້າເຖິງ"

msgid "Administrator - read/write, Users - read-only, Others - read-only"
msgstr "ຜູ້ດູແລລະບົບ - ອ່ານ/ຂຽນ, ຜູ້ໃຊ້ - ອ່ານຢ່າງດຽວ, ອື່ນໆ - ອ່ານຢ່າງດຽວ"

msgid "Administrator - read/write, Users - read/write, Others - no access"
msgstr "ຜູ້ດູແລລະບົບ - ອ່ານ/ຂຽນ, ຜູ້ໃຊ້ - ອ່ານ/ຂຽນ, ອື່ນໆ - ບໍ່ມີສິດເຂົ້າເຖິງ"

msgid "Administrator - read/write, Users - read/write, Others - read-only"
msgstr "ຜູ້ດູແລລະບົບ - ອ່ານ/ຂຽນ, ຜູ້ໃຊ້ - ອ່ານ/ຂຽນ, ອື່ນໆ - ອ່ານຢ່າງດຽວ"

msgid "Clear ACLs"
msgstr "ລຶບລ້າງ ACLs"

msgid "Clear all ACLs."
msgstr "ລຶບລ້າງ ACLs ທັງໝົດ."

msgid "Current Perms"
msgstr "ສິດປັດຈຸບັນ"

msgid "Docs"
msgstr "ເອກະສານ"

msgid "Everyone - read/write"
msgstr "ທຸກຄົນ - ອ່ານ/ຂຽນ"

msgid "In use by"
msgstr "ຖືກໃຊ້ໂດຍ"

msgid ""
"Lists sharedfolders in use.<br/>Click Reset button to reset permissions on "
"selected sharedfolder."
msgstr ""
"ສະແດງລາຍຊື່ໂຟນເດີທີ່ໃຊ້ຮ່ວມກັນທີ່ພວມຖືກໃຊ້.<br/>ຄລິກປຸ່ມ ຣີເຊັດ "
"ເພື່ອຕັ້ງຄ່າສິດໃນໂຟນເດີທີ່ເລືອກໃໝ່."

msgid "Path"
msgstr "ເສັ້ນທາງ"

msgid "Permissions"
msgstr "ສິດການເຂົ້າເຖິງ"

msgid "Permissions have been reset."
msgstr "ສິດການເຂົ້າເຖິງໄດ້ຖືກຕັ້ງຄ່າໃໝ່ແລ້ວ."

msgid "Reset"
msgstr "ຣີເຊັດ"

msgid "Reset Permissions"
msgstr "ຕັ້ງຄ່າສິດໃໝ່"

msgid "Reset permissions"
msgstr "ຕັ້ງຄ່າສິດໃໝ່"

msgid "Reset permissions ..."
msgstr "ກຳລັງຕັ້ງຄ່າສິດໃໝ່ ..."

msgid "Reset perms"
msgstr "ຣີເຊັດສິດ"

msgid "Resetting permissions ..."
msgstr "ກຳລັງຕັ້ງຄ່າສິດໃໝ່ ..."

msgid "Shared folder"
msgstr "ໂຟນເດີທີ່ໃຊ້ຮ່ວມກັນ"

msgid "omv-extras.org wiki"
msgstr "ວິກິ omv-extras.org"
